# Part 1: Basic Stress and Strain Calculator Template

def main():
    """Main function for the stress and strain calculator."""

    print("=== Stress and Strain Calculator ===")
    print()
    force = input("Enter applied force: ")
    area = input("Enter cross-sectional area: ")
    original_length = input("Enter original length: ")
    change_in_length = input("Enter change in length: ")

    #Conversion of inputs to float
    force = float(force)
    area = float(area)
    original_length = float(original_length)
    change_in_length = float(change_in_length)

    #Formulas for Stress and Strain
    stress = force / area
    strain = change_in_length / original_length

    #Print out the results with the proper format
    print()
    print("=== RESULTS ===")
    print(f"Stress: {stress:.2f} Pa")
    print(f"Strain: {strain:.6f}")
    print()
    print("=== Analysis Complete ===")

if __name__ == "__main__":
    main()